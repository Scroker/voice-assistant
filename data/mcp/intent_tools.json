{
  "volume_up": {
    "tool": "set_volume",
    "args": {
      "direction": "up"
    }
  },
  "volume_down": {
    "tool": "set_volume",
    "args": {
      "direction": "down"
    }
  },
  "mute": {
    "tool": "set_volume",
    "args": {
      "mute": true
    }
  },
  "unmute": {
    "tool": "set_volume",
    "args": {
      "mute": false
    }
  },
  "set_theme_dark": {
    "tool": "quick_settings",
    "args": {
      "setting": "dark_style",
      "enabled": true
    }
  },
  "set_theme_light": {
    "tool": "quick_settings",
    "args": {
      "setting": "dark_style",
      "enabled": false
    }
  },
  "theme_dark": {
    "tool": "quick_settings",
    "args": {
      "setting": "dark_style",
      "enabled": true
    }
  },
  "theme_light": {
    "tool": "quick_settings",
    "args": {
      "setting": "dark_style",
      "enabled": false
    }
  },
  "media_play": {
    "tool": "media_control",
    "args": {
      "action": "play"
    }
  },
  "media_pause": {
    "tool": "media_control",
    "args": {
      "action": "pause"
    }
  },
  "media_next": {
    "tool": "media_control",
    "args": {
      "action": "next"
    }
  },
  "media_prev": {
    "tool": "media_control",
    "args": {
      "action": "previous"
    }
  },
  "wifi_on": {
    "tool": "quick_settings",
    "args": {
      "setting": "wifi",
      "enabled": true
    }
  },
  "wifi_off": {
    "tool": "quick_settings",
    "args": {
      "setting": "wifi",
      "enabled": false
    }
  },
  "bluetooth_on": {
    "tool": "quick_settings",
    "args": {
      "setting": "bluetooth",
      "enabled": true
    }
  },
  "bluetooth_off": {
    "tool": "quick_settings",
    "args": {
      "setting": "bluetooth",
      "enabled": false
    }
  },
  "night_light_on": {
    "tool": "quick_settings",
    "args": {
      "setting": "night_light",
      "enabled": true
    }
  },
  "night_light_off": {
    "tool": "quick_settings",
    "args": {
      "setting": "night_light",
      "enabled": false
    }
  },
  "dnd_on": {
    "tool": "quick_settings",
    "args": {
      "setting": "do_not_disturb",
      "enabled": true
    }
  },
  "dnd_off": {
    "tool": "quick_settings",
    "args": {
      "setting": "do_not_disturb",
      "enabled": false
    }
  },
  "compose_mail": {
    "tool": "open_file",
    "args": {
      "path": "mailto:"
    }
  }
}
