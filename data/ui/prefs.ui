  <object class="AdwNavigationPage" id="model_selector_page">
    <property name="tag">model_selector_page</property>
    <property name="title" translatable="yes">Select Model</property>
    <property name="child">
      <object class="AdwBreakpointBin" id="selector_breakpoint_bin">
        <child>
          <object class="AdwBreakpoint" id="selector_breakpoint">
            <condition>max-width: 550sp</condition>
            <setter object="selector_header_bar" property="title-widget"></setter>
            <setter object="selector_view_switcher_bar" property="reveal">true</setter>
          </object>
        </child>
        <property name="child">
          <object class="AdwToolbarView" id="selector_toolbar_view">
            <child type="top">
              <object class="AdwHeaderBar" id="selector_header_bar">
                <property name="title-widget">
                  <object class="AdwViewSwitcher" id="selector_view_switcher">
                    <property name="stack">selector_view_stack</property>
                    <property name="policy">1</property>
                  </object>
                </property>
                <child type="end">
                  <object class="GtkButton" id="hf_download_dialog_btn">
                    <property name="icon-name">list-add-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Download from Hugging Face</property>
                    <property name="valign">3</property>
                    <property name="visible">false</property>
                  </object>
                </child>
              </object>
            </child>
            <property name="content">
              <object class="GtkScrolledWindow" id="selector_scrolled_window">
                <property name="hscrollbar-policy">2</property>
                <property name="vexpand">true</property>
                <property name="child">
                  <object class="GtkBox" id="selector_content_box">
                    <property name="orientation">1</property>
                    <property name="spacing">12</property>
                    <property name="margin-top">12</property>
                    <property name="margin-bottom">12</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <child>
                      <object class="AdwClamp">
                        <property name="maximum-size">600</property>
                        <child>
                          <object class="GtkSearchEntry" id="search_entry">
                            <property name="placeholder-text" translatable="yes">Search by name, language (it, en), size or provider...</property>
                            <property name="hexpand">true</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwClamp">
                        <property name="maximum-size">800</property>
                        <child>
                          <object class="AdwPreferencesGroup" id="llm_hf_custom_group">
                            <property name="visible">false</property>
                            <child>
                              <object class="AdwActionRow" id="hf_download_dialog_row">
                                <property name="title" translatable="yes">Hugging Face Repository Download</property>
                                <property name="subtitle" translatable="yes">Download custom GGUF models directly from Hugging Face</property>
                                <property name="activatable">true</property>
                                <child type="prefix">
                                  <object class="GtkImage">
                                    <property name="icon-name">folder-download-symbolic</property>
                                    <property name="valign">3</property>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="GtkImage">
                                    <property name="icon-name">go-next-symbolic</property>
                                    <property name="valign">3</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwClamp">
                        <property name="maximum-size">800</property>
                        <child>
                          <object class="AdwViewStack" id="selector_view_stack">
                            <property name="vhomogeneous">false</property>
                            <property name="hhomogeneous">false</property>
                            <child>
                              <object class="AdwViewStackPage" id="page_all">
                                <property name="name">all</property>
                                <property name="title" translatable="yes">All</property>
                                <property name="icon-name">brain-augmented-symbolic</property>
                                <property name="child">
                                  <object class="AdwPreferencesGroup" id="models_group_all">
                                    <property name="title" translatable="yes">Available Models</property>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwViewStackPage" id="page_installed">
                                <property name="name">installed</property>
                                <property name="title" translatable="yes">Installed</property>
                                <property name="icon-name">folder-download-symbolic</property>
                                <property name="child">
                                  <object class="AdwPreferencesGroup" id="models_group_installed">
                                    <property name="title" translatable="yes">Installed Models</property>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwViewStackPage" id="page_downloading">
                                <property name="name">downloading</property>
                                <property name="title" translatable="yes">Downloading</property>
                                <property name="icon-name">system-run-symbolic</property>
                                <property name="child">
                                  <object class="AdwPreferencesGroup" id="models_group_downloading">
                                    <property name="title" translatable="yes">Downloading Models</property>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
            <child type="bottom">
              <object class="AdwViewSwitcherBar" id="selector_view_switcher_bar">
                <property name="stack">selector_view_stack</property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
  <object class="AdwNavigationPage" id="lang_nav_page">
    <property name="tag">lang_page</property>
    <property name="title" translatable="yes">Select Language</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle">
                <property name="title" translatable="yes">Select Language</property>
              </object>
            </property>
          </object>
        </child>
        <property name="content">
          <object class="GtkBox">
            <property name="orientation">1</property>
            <property name="spacing">12</property>
            <property name="margin-top">12</property>
            <property name="margin-bottom">12</property>
            <property name="margin-start">16</property>
            <property name="margin-end">16</property>
            <child>
              <object class="GtkSearchEntry" id="lang_search_entry">
                <property name="placeholder-text" translatable="yes">Search language or code...</property>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">2</property>
                <property name="vexpand">true</property>
                <property name="child">
                  <object class="GtkListBox" id="lang_list_box">
                    <property name="selection-mode">0</property>
                    <style>
                      <class name="boxed-list"/>
                    </style>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
  <object class="AdwNavigationPage" id="models_subpage">
    <property name="tag">models_subpage</property>
    <property name="title" translatable="yes">Storage and Models</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle">
                <property name="title" translatable="yes">Storage and Models</property>
              </object>
            </property>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage" id="models_page">
            <property name="title" translatable="yes">Storage and Models</property>
            <property name="icon-name">drive-harddisk-symbolic</property>
            <property name="name">models</property>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Storage Location</property>
                <property name="description" translatable="yes">Base directory for all downloaded models. Subfolders are created automatically.</property>
                <child>
                  <object class="AdwActionRow" id="models_path_row">
                    <property name="title" translatable="yes">Base Directory</property>
                    <child type="suffix">
                      <object class="GtkButton" id="choose_path_btn">
                        <property name="icon-name">folder-open-symbolic</property>
                        <property name="valign">3</property>
                        <property name="tooltip-text" translatable="yes">Select directory</property>
                        <style>
                          <class name="flat"/>
                        </style>
                      </object>
                    </child>
                    <child type="suffix">
                      <object class="GtkButton" id="reset_path_btn">
                        <property name="icon-name">edit-clear-symbolic</property>
                        <property name="valign">3</property>
                        <property name="tooltip-text" translatable="yes">Reset to default path</property>
                        <style>
                          <class name="flat"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow" id="models_total_size_row">
                    <property name="title" translatable="yes">Total Occupied Space</property>
                    <property name="subtitle" translatable="yes">Calculating...</property>
                    <style>
                      <class name="property"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwButtonRow" id="clean_unused_btn">
                    <property name="title" translatable="yes">Remove Unused Models</property>
                    <style>
                      <class name="destructive-action"/>
                    </style>
                    <property name="end-icon-name">user-trash-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="ww_models_group">
                <property name="title" translatable="yes">Wake Word</property>
                <child type="header-suffix">
                  <object class="GtkButton" id="ww_open_btn">
                    <property name="label" translatable="yes">Open</property>
                    <property name="valign">3</property>
                    <property name="has-frame">false</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="stt_models_group">
                <property name="title" translatable="yes">Speech Recognition (STT)</property>
                <child type="header-suffix">
                  <object class="GtkButton" id="stt_open_btn">
                    <property name="label" translatable="yes">Open</property>
                    <property name="valign">3</property>
                    <property name="has-frame">false</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="llm_models_group">
                <property name="title" translatable="yes">Language Model (LLM)</property>
                <child type="header-suffix">
                  <object class="GtkButton" id="llm_open_btn">
                    <property name="label" translatable="yes">Open</property>
                    <property name="valign">3</property>
                    <property name="has-frame">false</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="tts_models_group">
                <property name="title" translatable="yes">Text-to-Speech (TTS)</property>
                <child type="header-suffix">
                  <object class="GtkButton" id="tts_open_btn">
                    <property name="label" translatable="yes">Open</property>
                    <property name="valign">3</property>
                    <property name="has-frame">false</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
  <object class="AdwNavigationPage" id="audio_subpage">
    <property name="tag">audio_subpage</property>
    <property name="title" translatable="yes">Audio Filters</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle">
                <property name="title" translatable="yes">Audio Filters</property>
              </object>
            </property>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage" id="audio_page">
            <property name="title" translatable="yes">Audio Filters</property>
            <property name="icon-name">audio-input-microphone-symbolic</property>
            <property name="name">audio</property>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Echo Cancellation</property>
                <property name="description" translatable="yes">System-level PipeWire WebRTC processing, applied before the assistant receives audio. Prevents the assistant from hearing its own voice.</property>
                <child>
                  <object class="AdwSwitchRow" id="audio_aec_row">
                    <property name="title" translatable="yes">Cancel echo and suppress noise</property>
                    <property name="subtitle" translatable="yes">Requires restarting listening to take effect</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">High-Pass Filter</property>
                <property name="description" translatable="yes">Removes low-frequency hum, desk vibrations and fan noise from the microphone signal.</property>
                <child>
                  <object class="AdwSwitchRow" id="audio_highpass_row">
                    <property name="title" translatable="yes">Enable high-pass filter</property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="audio_highpass_cutoff_row">
                    <property name="title" translatable="yes">Cutoff frequency</property>
                    <property name="subtitle" translatable="yes">Hz — higher values remove more rumble but thin out the voice</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">20</property>
                        <property name="upper">500</property>
                        <property name="step-increment">5</property>
                        <property name="page-increment">20</property>
                      </object>
                    </property>
                    <property name="digits">0</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Automatic Gain Control</property>
                <property name="description" translatable="yes">Normalizes speech volume to compensate for a microphone whose system gain is too low or too high.</property>
                <child>
                  <object class="AdwSwitchRow" id="audio_agc_row">
                    <property name="title" translatable="yes">Enable automatic gain control</property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="audio_agc_target_row">
                    <property name="title" translatable="yes">Target speech level</property>
                    <property name="subtitle" translatable="yes">RMS level the assistant tries to reach</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">200</property>
                        <property name="upper">8000</property>
                        <property name="step-increment">50</property>
                        <property name="page-increment">200</property>
                      </object>
                    </property>
                    <property name="digits">0</property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="audio_agc_max_gain_row">
                    <property name="title" translatable="yes">Maximum gain</property>
                    <property name="subtitle" translatable="yes">High values pick up distant voices but also amplify background noise</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">1</property>
                        <property name="upper">8</property>
                        <property name="step-increment">0.1</property>
                        <property name="page-increment">0.5</property>
                      </object>
                    </property>
                    <property name="digits">1</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Noise Gate</property>
                <property name="description" translatable="yes">Attenuates audio below a threshold computed from the room's background noise, so ambient noise is not sent to speech recognition.</property>
                <child>
                  <object class="AdwSwitchRow" id="audio_gate_row">
                    <property name="title" translatable="yes">Enable adaptive noise gate</property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="audio_gate_threshold_row">
                    <property name="title" translatable="yes">Sensitivity</property>
                    <property name="subtitle" translatable="yes">Multiplier over the detected noise floor — higher values require louder speech</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">1</property>
                        <property name="upper">10</property>
                        <property name="step-increment">0.1</property>
                        <property name="page-increment">0.5</property>
                      </object>
                    </property>
                    <property name="digits">1</property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="audio_gate_attenuation_row">
                    <property name="title" translatable="yes">Attenuation</property>
                    <property name="subtitle" translatable="yes">0.00 mutes below-threshold audio completely, 1.00 leaves it untouched</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">0</property>
                        <property name="upper">1</property>
                        <property name="step-increment">0.05</property>
                        <property name="page-increment">0.1</property>
                      </object>
                    </property>
                    <property name="digits">2</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwButtonRow" id="audio_reset_btn">
                    <property name="title" translatable="yes">Restore Default Values</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
  <object class="AdwNavigationPage" id="dispatch_subpage">
    <property name="tag">dispatch_subpage</property>
    <property name="title" translatable="yes">Command Dispatch</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle">
                <property name="title" translatable="yes">Command Dispatch</property>
              </object>
            </property>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage" id="dispatch_page">
            <property name="title" translatable="yes">Command Dispatch</property>
            <property name="icon-name">media-playlist-consecutive-symbolic</property>
            <property name="name">dispatch</property>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="description" translatable="yes">A recognized command goes through up to three stages, stopping at the first one that resolves it: Fast-Path, Medium-Path, then Smart-Path. Disabling a stage makes commands fall through to the next one.</property>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Fast-Path</property>
                <property name="description" translatable="yes">Runs frequent commands (volume, theme, media, clock, launching apps) straight from regex patterns and semantic matching, without asking the language model. Responds in under 10 ms but only recognizes known phrasings.</property>
                <child>
                  <object class="AdwSwitchRow" id="dispatch_fast_path_row">
                    <property name="title" translatable="yes">Enable Fast-Path</property>
                    <property name="subtitle" translatable="yes">Fastest, deterministic — no model involved</property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="dispatch_semantic_threshold_row">
                    <property name="title" translatable="yes">Semantic Router Confidence Threshold</property>
                    <property name="subtitle" translatable="yes">Minimum similarity score required to execute an action directly instead of falling through</property>
                    <property name="digits">2</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">0.5</property>
                        <property name="upper">0.95</property>
                        <property name="step-increment">0.05</property>
                        <property name="page-increment">0.05</property>
                        <property name="value">0.62</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Medium-Path</property>
                <property name="description" translatable="yes">Asks the language model to pick a single tool to run, without generating free text. Slower than Fast-Path but understands phrasings it has never seen. Requires MCP tools and a configured model.</property>
                <child>
                  <object class="AdwSwitchRow" id="dispatch_medium_path_row">
                    <property name="title" translatable="yes">Enable Medium-Path</property>
                    <property name="subtitle" translatable="yes">Model-assisted tool selection</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Smart-Path</property>
                <property name="description" translatable="yes">Always active as the final stage: full conversation with memory, document retrieval and tool calling. Handles everything the previous stages leave unresolved.</property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
  <object class="AdwNavigationPage" id="bugreport_subpage">
    <property name="tag">bugreport_subpage</property>
    <property name="title" translatable="yes">Bug Reporting</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle">
                <property name="title" translatable="yes">Bug Reporting</property>
              </object>
            </property>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage" id="bugreport_page">
            <property name="title" translatable="yes">Bug Reporting</property>
            <property name="icon-name">dialog-warning-symbolic</property>
            <property name="name">bugreport</property>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Segnalazione errori</property>
                <child>
                  <object class="AdwSwitchRow" id="bugreport_enable_row">
                    <property name="title" translatable="yes">Abilita segnalazione automatica</property>
                    <property name="subtitle" translatable="yes">Invia le eccezioni non gestite all'istanza Bugzilla configurata</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Configurazione Bugzilla</property>
                <property name="description" translatable="yes">Le credenziali vengono usate solo per inviare report e non vengono condivise con terze parti.</property>
                <child>
                  <object class="AdwEntryRow" id="bugreport_endpoint_row">
                    <property name="title" translatable="yes">Endpoint (URL base)</property>
                    <property name="input-purpose">5</property>
                  </object>
                </child>
                <child>
                  <object class="AdwPasswordEntryRow" id="bugreport_apikey_row">
                    <property name="title" translatable="yes">API Key</property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="bugreport_product_row">
                    <property name="title" translatable="yes">Prodotto</property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="bugreport_component_row">
                    <property name="title" translatable="yes">Componente</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwButtonRow" id="test_bugreport_btn">
                    <property name="title" translatable="yes">Test connessione</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
  <object class="AdwNavigationPage" id="mcp_subpage">
    <property name="tag">mcp_subpage</property>
    <property name="title" translatable="yes">Tools (MCP)</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle">
                <property name="title" translatable="yes">Tools (MCP)</property>
              </object>
            </property>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage" id="mcp_page">
            <property name="title" translatable="yes">Tools (MCP)</property>
            <property name="icon-name">system-run-symbolic</property>
            <property name="name">mcp</property>
            <child>
              <object class="AdwPreferencesGroup" id="mcp_enable_group">
                <property name="title" translatable="yes">Model Context Protocol (MCP)</property>
                <property name="description" translatable="yes">Integration with system tools and external capabilities.</property>
                <child>
                  <object class="AdwSwitchRow" id="mcp_enable_row">
                    <property name="title" translatable="yes">Enable Model Context Protocol</property>
                    <property name="subtitle" translatable="yes">Allow assistant to execute actions via MCP tools</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="mcp_config_group">
                <property name="title" translatable="yes">MCP Configuration</property>
                <property name="description" translatable="yes">Settings for tool registries and servers.</property>
                <child>
                  <object class="AdwEntryRow" id="mcp_registry_url_row">
                    <property name="title" translatable="yes">Registry URL</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="mcp_servers_group">
                <property name="title" translatable="yes">Configured Servers</property>
                <property name="description" translatable="yes">Active MCP server connections.</property>
                <child>
                  <object class="AdwActionRow" id="mcp_server_gnome_row">
                    <property name="title" translatable="yes">GNOME MCP Server</property>
                    <property name="subtitle" translatable="yes">System integration tools (desktop, notifications, apps)</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
  <object class="AdwNavigationPage" id="skills_subpage">
    <property name="tag">skills_subpage</property>
    <property name="title" translatable="yes">Skills</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle">
                <property name="title" translatable="yes">Skills</property>
              </object>
            </property>
            <child type="end">
              <object class="GtkButton" id="skills_add_btn">
                <property name="icon-name">list-add-symbolic</property>
                <property name="tooltip-text" translatable="yes">Add custom skill</property>
                <style>
                  <class name="flat"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">
            <property name="title" translatable="yes">Skills</property>
            <property name="icon-name">applications-utilities-symbolic</property>
            <property name="name">skills</property>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="description" translatable="yes">Skills teach the Direct Action Engine to recognize a spoken phrase and run an MCP tool for it. Built-in skills are read-only; add your own below.</property>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="skills_list_group">
                <property name="title" translatable="yes">Configured Skills</property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
  <object class="AdwNavigationPage" id="skill_editor_subpage">
    <property name="tag">skill_editor_subpage</property>
    <property name="title" translatable="yes">Skill</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle">
                <property name="title" translatable="yes">Skill</property>
              </object>
            </property>
            <child type="end">
              <object class="GtkButton" id="skill_editor_save_btn">
                <property name="label" translatable="yes">Save</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">
            <property name="title" translatable="yes">Skill</property>
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwActionRow" id="skill_editor_error_row">
                    <property name="title" translatable="yes">Error</property>
                    <property name="visible">false</property>
                    <style>
                      <class name="error"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Details</property>
                <child>
                  <object class="AdwEntryRow" id="skill_editor_name_row">
                    <property name="title" translatable="yes">Display Name</property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="skill_editor_intent_row">
                    <property name="title" translatable="yes">Intent</property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="skill_editor_tool_row">
                    <property name="title" translatable="yes">MCP Tool</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Trigger Phrases</property>
                <property name="description" translatable="yes">One phrase per line. The semantic router matches spoken text against these.</property>
                <child>
                  <object class="GtkFrame">
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="min-content-height">100</property>
                        <property name="hscrollbar-policy">2</property>
                        <child>
                          <object class="GtkTextView" id="skill_editor_triggers_view">
                            <property name="top-margin">8</property>
                            <property name="bottom-margin">8</property>
                            <property name="left-margin">8</property>
                            <property name="right-margin">8</property>
                            <property name="wrap-mode">2</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Tool Arguments</property>
                <property name="description" translatable="yes">JSON object passed to the MCP tool, e.g. {"setting": "wifi", "enabled": true}.</property>
                <child>
                  <object class="GtkFrame">
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="min-content-height">80</property>
                        <property name="hscrollbar-policy">2</property>
                        <child>
                          <object class="GtkTextView" id="skill_editor_args_view">
                            <property name="top-margin">8</property>
                            <property name="bottom-margin">8</property>
                            <property name="left-margin">8</property>
                            <property name="right-margin">8</property>
                            <property name="wrap-mode">2</property>
                            <property name="monospace">true</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="GtkButton" id="skill_editor_delete_btn">
                    <property name="label" translatable="yes">Delete Skill</property>
                    <style>
                      <class name="destructive-action"/>
                    </style>
                    <property name="halign">1</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>