using Gtk 4.0;
using Adw 1;

Adw.NavigationSplitView split_view {
  min-sidebar-width: 260;

  sidebar: Adw.NavigationPage sidebar_page {
    title: _("Preferences");
    styles ["sidebar"]

    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        title-widget: Adw.WindowTitle {
          title: _("Preferences");
        };
      }

      content: Gtk.ScrolledWindow {
        hscrollbar-policy: never;
        vexpand: true;

        child: Gtk.ListBox sidebar_list_box {
          selection-mode: single;
          styles ["navigation-sidebar"]

          Adw.ActionRow row_general {
            title: _("General");
            activatable: true;

            [prefix]
            Gtk.Image {
              icon-name: "preferences-system-symbolic";
              margin-end: 12;
            }
          }

          Adw.ActionRow row_wakeword {
            title: _("Wake Word");
            activatable: true;

            [prefix]
            Gtk.Image {
              icon-name: "audio-input-microphone-symbolic";
              margin-end: 12;
            }
          }

          Adw.ActionRow row_stt {
            title: _("Speech Engine (STT)");
            activatable: true;

            [prefix]
            Gtk.Image {
              icon-name: "audio-input-microphone-symbolic";
              margin-end: 12;
            }
          }

          Adw.ActionRow row_llm {
            title: _("Artificial Intelligence (LLM)");
            activatable: true;

            [prefix]
            Gtk.Image {
              icon-name: "brain-augmented-symbolic";
              margin-end: 12;
            }
          }

          Adw.ActionRow row_tts {
            title: _("Text-to-Speech (TTS)");
            activatable: true;

            [prefix]
            Gtk.Image {
              icon-name: "audio-volume-high-symbolic";
              margin-end: 12;
            }
          }

          Adw.ActionRow row_mcp {
            title: _("Tools (MCP)");
            activatable: true;

            [prefix]
            Gtk.Image {
              icon-name: "system-run-symbolic";
              margin-end: 12;
            }
          }

          Adw.ActionRow row_models {
            title: _("Storage and Models");
            activatable: true;

            [prefix]
            Gtk.Image {
              icon-name: "drive-harddisk-symbolic";
              margin-end: 12;
            }
          }

          Adw.ActionRow row_about {
            title: _("About");
            activatable: true;

            [prefix]
            Gtk.Image {
              icon-name: "help-about-symbolic";
              margin-end: 12;
            }
          }
        };
      };
    };
  };

  content: Adw.NavigationPage content_wrapper_page {
    title: _("Content");

    child: Adw.NavigationView content_navigation_view {
      Adw.NavigationPage main_content_nav_page {
        title: _("General");

        child: Adw.ToolbarView content_toolbar_view {
          [top]
          Adw.HeaderBar content_header_bar {
            title-widget: Adw.WindowTitle content_title {
              title: _("General");
            };
          }

          content: Gtk.ScrolledWindow {
            hscrollbar-policy: never;
            vexpand: true;

            child: Gtk.Stack stack {
              transition-type: crossfade;
              vexpand: true;
              hexpand: true;

              // 1. GENERAL PAGE
              Adw.PreferencesPage general_page {
                Adw.PreferencesGroup {
                  title: _("Voice Assistant");
                  description: _("General configuration and assistant activation.");

                  Adw.SwitchRow enable_switch_row {
                    title: _("Enable Voice Assistant");
                    subtitle: _("Enable or disable background listening");
                  }
                }
              }

              Adw.PreferencesPage wakeword_page {
                Adw.PreferencesGroup lang_group {
                  title: _("Assistant Language");
                  description: _("Language used for speech recognition and responses");

                  Adw.ActionRow lang_it_row {
                    title: _("Italian (it)");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton lang_it_radio {
                      valign: center;
                      margin-end: 12;
                    }
                  }

                  Adw.ActionRow lang_en_row {
                    title: _("English (en)");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton lang_en_radio {
                      group: lang_it_radio;
                      valign: center;
                      margin-end: 12;
                    }
                  }
                }

                Adw.PreferencesGroup wakeword_engine_group {
                  title: _("Wakeword Engine");
                  description: _("Vosk: any word — OpenWakeWord: fixed keywords — Sherpa-ONNX: custom ONNX keyword spotter");

                  Adw.ActionRow ww_engine_vosk_row {
                    title: _("Vosk (custom word)");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton ww_engine_vosk_radio {
                      valign: center;
                      margin-end: 12;
                    }
                  }

                  Adw.ActionRow ww_engine_oww_row {
                    title: _("OpenWakeWord (fixed keywords)");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton ww_engine_oww_radio {
                      group: ww_engine_vosk_radio;
                      valign: center;
                      margin-end: 12;
                    }
                  }

                  Adw.ActionRow ww_engine_sherpa_row {
                    title: _("Sherpa-ONNX (keyword spotting)");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton ww_engine_sherpa_radio {
                      group: ww_engine_vosk_radio;
                      valign: center;
                      margin-end: 12;
                    }
                  }
                }

                Adw.PreferencesGroup wakeword_config_group {
                  title: _("Configuration");

                  Adw.EntryRow wakeword_row {
                    title: _("Wakeword");
                    subtitle: _("Word that activates the assistant (Vosk / Sherpa-ONNX)");
                  }

                  Adw.EntryRow sherpa_model_dir_row {
                    title: _("Sherpa-ONNX Model Directory");
                    subtitle: _("Folder with encoder/decoder/joiner .onnx and tokens.txt — leave empty to auto-download");
                    visible: false;
                  }
                }

                Adw.PreferencesGroup oww_keyword_group {
                  title: _("OpenWakeWord Keyword");
                  description: _("Pre-trained keyword model to detect");
                  visible: false;

                  Adw.ActionRow oww_alexa_row {
                    title: _("alexa");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton oww_alexa_radio {
                      valign: center;
                      margin-end: 12;
                    }
                  }

                  Adw.ActionRow oww_hey_jarvis_row {
                    title: _("hey_jarvis");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton oww_hey_jarvis_radio {
                      group: oww_alexa_radio;
                      valign: center;
                      margin-end: 12;
                    }
                  }

                  Adw.ActionRow oww_hey_mycroft_row {
                    title: _("hey_mycroft");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton oww_hey_mycroft_radio {
                      group: oww_alexa_radio;
                      valign: center;
                      margin-end: 12;
                    }
                  }

                  Adw.ActionRow oww_hey_rhasspy_row {
                    title: _("hey_rhasspy");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton oww_hey_rhasspy_radio {
                      group: oww_alexa_radio;
                      valign: center;
                      margin-end: 12;
                    }
                  }
                }
              }

              // 2. STT PAGE
              Adw.PreferencesPage stt_page {
                Adw.PreferencesGroup stt_mode_group {
                  title: _("Speech Recognition Mode");
                  description: _("Select whether to process voice locally on device or via a cloud API service.");

                  Adw.ActionRow stt_mode_local_row {
                    title: _("Local Models (Vosk / Whisper)");
                    subtitle: _("Offline speech recognition processed locally on device");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton stt_mode_local_radio {
                      valign: center;
                      margin-end: 12;
                    }
                  }

                  Adw.ActionRow stt_mode_cloud_row {
                    title: _("Cloud Service (OpenAI / Groq)");
                    subtitle: _("High-accuracy online speech recognition via API");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton stt_mode_cloud_radio {
                      group: stt_mode_local_radio;
                      valign: center;
                      margin-end: 12;
                    }
                  }
                }

                Adw.PreferencesGroup stt_local_group {
                  title: _("Local STT Model Configuration");
                  description: _("Configure offline model execution.");

                  Adw.ActionRow current_model_row {
                    title: _("Active Local STT Model");
                    subtitle: _("Loading information...");
                    activatable: true;

                    [prefix]
                    Gtk.Image {
                      icon-name: "audio-input-microphone-symbolic";
                      margin-end: 12;
                    }

                    [suffix]
                    Gtk.Button open_model_selector_btn {
                      icon-name: "go-next-symbolic";
                      valign: center;
                      styles ["flat"]
                    }
                  }
                }

                Adw.PreferencesGroup stt_cloud_group {
                  title: _("Cloud STT Provider");
                  description: _("Choose provider and API credentials for Cloud STT.");

                  Adw.ActionRow stt_cloud_openai_row {
                    title: _("OpenAI Whisper Cloud");
                    subtitle: _("api.openai.com");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton stt_cloud_openai_radio {
                      valign: center;
                      margin-end: 12;
                    }
                  }

                  Adw.ActionRow stt_cloud_groq_row {
                    title: _("Groq Whisper Cloud");
                    subtitle: _("api.groq.com");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton stt_cloud_groq_radio {
                      group: stt_cloud_openai_radio;
                      valign: center;
                      margin-end: 12;
                    }
                  }

                  Adw.EntryRow stt_cloud_api_key_row {
                    title: _("API Key");
                  }

                  Adw.EntryRow stt_cloud_model_row {
                    title: _("Cloud Model Name");
                  }
                }

                Adw.PreferencesGroup whisper_hardware_group {
                  title: _("Hardware Acceleration (Whisper)");
                  description: _("Configure the compute device for Whisper execution.");

                  Adw.ActionRow hw_cpu_row {
                    title: _("CPU (Compatible with all systems)");
                    subtitle: _("Standard execution via CPU");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton hw_cpu_radio {
                      valign: center;
                      margin-end: 12;
                    }
                  }

                  Adw.ActionRow hw_cuda_row {
                    title: _("CUDA (Nvidia GPU)");
                    subtitle: _("Hardware acceleration via Nvidia graphics card");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton hw_cuda_radio {
                      group: hw_cpu_radio;
                      valign: center;
                      margin-end: 12;
                    }
                  }
                }
              }

              // 3. LLM PAGE
              Adw.PreferencesPage llm_page {
                Adw.PreferencesGroup {
                  title: _("Large Language Model (LLM)");
                  description: _("Enable and configure text generation capabilities.");

                  Adw.SwitchRow llm_enable_row {
                    title: _("Enable LLM Responses");
                    subtitle: _("Send voice transcriptions to the LLM to generate intelligent responses");
                  }
                }

                Adw.PreferencesGroup llm_mode_group {
                  title: _("Execution Engine");
                  description: _("Select how the language model is executed.");

                  Adw.ActionRow llm_mode_local_row {
                    title: _("Local GGUF (In-Daemon Llama 3.2)");
                    subtitle: _("Runs locally within Python daemon");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton llm_mode_local_radio {
                      valign: center;
                      margin-end: 12;
                    }
                  }

                  Adw.ActionRow llm_mode_ollama_row {
                    title: _("Ollama (Local HTTP)");
                    subtitle: _("Connect to local Ollama instance");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton llm_mode_ollama_radio {
                      group: llm_mode_local_radio;
                      valign: center;
                      margin-end: 12;
                    }
                  }

                  Adw.ActionRow llm_mode_openai_row {
                    title: _("OpenAI Cloud API");
                    subtitle: _("ChatGPT models via api.openai.com");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton llm_mode_openai_radio {
                      group: llm_mode_local_radio;
                      valign: center;
                      margin-end: 12;
                    }
                  }

                  Adw.ActionRow llm_mode_anthropic_row {
                    title: _("Anthropic Claude API");
                    subtitle: _("Claude 3.5 models via api.anthropic.com");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton llm_mode_anthropic_radio {
                      group: llm_mode_local_radio;
                      valign: center;
                      margin-end: 12;
                    }
                  }

                  Adw.ActionRow llm_mode_custom_row {
                    title: _("Custom HTTP Endpoint");
                    subtitle: _("Custom OpenAI-compatible API server");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton llm_mode_custom_radio {
                      group: llm_mode_local_radio;
                      valign: center;
                      margin-end: 12;
                    }
                  }
                }

                Adw.PreferencesGroup llm_local_group {
                  title: _("Local LLM Model Configuration");
                  description: _("Configure offline GGUF model execution.");

                  Adw.ActionRow current_llm_model_row {
                    title: _("Active Local LLM Model");
                    subtitle: _("Loading information...");
                    activatable: true;

                    [prefix]
                    Gtk.Image {
                      icon-name: "brain-augmented-symbolic";
                      margin-end: 12;
                    }

                    [suffix]
                    Gtk.Button open_llm_model_selector_btn {
                      icon-name: "go-next-symbolic";
                      valign: center;
                      styles ["flat"]
                    }
                  }
                }

                Adw.PreferencesGroup llm_hf_custom_group {
                  title: _("Hugging Face Repository Download");
                  description: _("Download any GGUF model directly from Hugging Face by entering the repository ID or model path (e.g. bartowski/Llama-3.2-1B-Instruct-GGUF or repo_id:file.gguf)");

                  Adw.EntryRow custom_hf_entry_row {
                    title: _("Import Hugging Face Model");
                    show-apply-button: true;
                  }
                }

                Adw.PreferencesGroup llm_config_group {
                  title: _("Engine Configuration");

                  Adw.EntryRow llm_api_key_row {
                    title: _("API Key");
                  }

                  Adw.EntryRow llm_system_prompt_row {
                    title: _("System Prompt (Instructions)");
                  }

                  Adw.EntryRow llm_url_row {
                    title: _("Server Endpoint URL");
                  }

                  Adw.EntryRow llm_model_row {
                    title: _("Model Name");
                  }
                }
              }

              // 4. TTS PAGE
              Adw.PreferencesPage tts_page {
                Adw.PreferencesGroup {
                  title: _("Speech Synthesis (Text-To-Speech)");
                  description: _("Configure the voice engine for audio playback of assistant responses.");

                  Adw.SwitchRow tts_enable_row {
                    title: _("Enable Speech Synthesis");
                    subtitle: _("Play assistant response through speakers");
                  }
                }

                Adw.PreferencesGroup tts_engine_group {
                  title: _("TTS Engine");
                  description: _("Select speech synthesis provider.");

                  Adw.ActionRow tts_engine_piper_row {
                    title: _("Piper (Local ONNX)");
                    subtitle: _("Fast local neural speech synthesis");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton tts_engine_piper_radio {
                      valign: center;
                      margin-end: 12;
                    }
                  }

                  Adw.ActionRow tts_engine_espeak_row {
                    title: _("eSpeak NG");
                    subtitle: _("Lightweight local formant synthesizer");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton tts_engine_espeak_radio {
                      group: tts_engine_piper_radio;
                      valign: center;
                      margin-end: 12;
                    }
                  }

                  Adw.ActionRow tts_engine_openai_row {
                    title: _("OpenAI Cloud TTS");
                    subtitle: _("High quality cloud speech synthesis");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton tts_engine_openai_radio {
                      group: tts_engine_piper_radio;
                      valign: center;
                      margin-end: 12;
                    }
                  }

                  Adw.ActionRow tts_engine_system_row {
                    title: _("System Speech Dispatcher");
                    subtitle: _("Default OS speech synthesis engine");
                    activatable: true;

                    [prefix]
                    Gtk.CheckButton tts_engine_system_radio {
                      group: tts_engine_piper_radio;
                      valign: center;
                      margin-end: 12;
                    }
                  }
                }

                Adw.PreferencesGroup tts_config_group {
                  title: _("Voice Configuration");

                  Adw.EntryRow tts_voice_row {
                    title: _("Voice Model / Name");
                  }
                }
              }

              // 5. MCP PAGE
              Adw.PreferencesPage mcp_page {
                Adw.PreferencesGroup {
                  title: _("Model Context Protocol (MCP)");
                  description: _("Integration with system tools and services.");

                  Adw.ActionRow {
                    title: _("MCP Integration Status");
                    subtitle: _("Ready for tool &amp; function calling integration");
                  }
                }
              }

              // 6. MODELS / STORAGE PAGE
              Adw.PreferencesPage models_page {
                Adw.PreferencesGroup {
                  title: _("Storage Location");
                  description: _("Change the local directory where downloaded models are stored.");

                  Adw.ActionRow models_path_row {
                    title: _("Models Directory");

                    [suffix]
                    Gtk.Button choose_path_btn {
                      icon-name: "folder-open-symbolic";
                      valign: center;
                      tooltip-text: _("Select directory");
                      styles ["flat"]
                    }

                    [suffix]
                    Gtk.Button reset_path_btn {
                      icon-name: "edit-clear-symbolic";
                      valign: center;
                      tooltip-text: _("Reset to default path");
                      styles ["flat"]
                    }
                  }
                }

                Adw.PreferencesGroup cache_group {
                  title: _("Cache &amp; Downloaded Models Management");

                  [header-suffix]
                  Gtk.Button clean_unused_btn {
                    label: _("Remove Unused");
                    valign: center;
                    styles ["flat", "error"]

                    [prefix]
                    Gtk.Image {
                      icon-name: "user-trash-symbolic";
                    }
                  }
                }
              }

              // 7. ABOUT PAGE
              Adw.PreferencesPage about_page {
                Adw.PreferencesGroup {
                  title: _("Voice Assistant");

                  Adw.ActionRow {
                    title: _("Voice Assistant GNOME Extension");
                    subtitle: _("Offline and integrated voice assistant for GNOME Shell");
                  }

                  Adw.ActionRow {
                    title: _("Version");
                    subtitle: "1.0.0";
                  }

                  Adw.ActionRow {
                    title: _("Backend D-Bus Service");
                    subtitle: "org.local.VoiceAssistant";
                  }

                  Adw.ActionRow doc_row {
                    title: _("Source Code &amp; Documentation");
                    subtitle: "https://github.com/Scroker/voice-assistant";

                    [suffix]
                    Gtk.Button doc_btn {
                      icon-name: "web-browser-symbolic";
                      valign: center;
                      styles ["flat"]
                    }
                  }
                }
              }
            };
          };
        };
      }

      // MODEL SELECTOR SUB-PAGE
      Adw.NavigationPage model_selector_page {
        child: Adw.ToolbarView selector_toolbar_view {
          [top]
          Adw.HeaderBar selector_header_bar {
            title-widget: Adw.ViewSwitcher selector_view_switcher {
              stack: selector_view_stack;
              policy: wide;
            };
          }

          content: Gtk.ScrolledWindow {
            hscrollbar-policy: never;
            vexpand: true;

            child: Gtk.Box selector_content_box {
              orientation: vertical;
              spacing: 12;
              margin-top: 12;
              margin-bottom: 12;
              margin-start: 12;
              margin-end: 12;

              Adw.Clamp {
                maximum-size: 600;

                Gtk.SearchEntry search_entry {
                  placeholder-text: _("Search by name, language (it, en), size or provider...");
                  hexpand: true;
                }
              }

              Adw.Clamp {
                maximum-size: 800;

                Adw.ViewStack selector_view_stack {
                  Adw.ViewStackPage page_all {
                    name: "all";
                    title: _("All");
                    icon-name: "brain-augmented-symbolic";

                    child: Adw.PreferencesGroup models_group_all {
                      title: _("Available Models");
                    };
                  }

                  Adw.ViewStackPage page_installed {
                    name: "installed";
                    title: _("Installed");
                    icon-name: "folder-download-symbolic";

                    child: Adw.PreferencesGroup models_group_installed {
                      title: _("Installed Models");
                    };
                  }

                  Adw.ViewStackPage page_downloading {
                    name: "downloading";
                    title: _("Downloading");
                    icon-name: "system-run-symbolic";

                    child: Adw.PreferencesGroup models_group_downloading {
                      title: _("Downloading Models");
                    };
                  }
                }
              }
            };
          };

          [bottom]
          Adw.ViewSwitcherBar selector_view_switcher_bar {
            stack: selector_view_stack;
          }
        };
      }
    };
  };
}
