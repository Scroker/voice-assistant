      Adw.ActionRow current_tts_model_row {
        title: _("Active Voice Model (Piper)");
        subtitle: _("Loading information...");
        activatable: true;

        [prefix]
        Gtk.Image {
          icon-name: "audio-volume-high-symbolic";
          margin-end: 12;
        }

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup tts_cloud_engine_group {
      title: _("Cloud TTS Provider");
      description: _("Select cloud speech synthesis service.");
      visible: false;

      Adw.ActionRow tts_engine_openai_row {
        title: _("OpenAI Cloud TTS");
        subtitle: _("High quality cloud speech synthesis");
        activatable: true;
        activatable-widget: tts_engine_openai_radio;

        [prefix]
        Gtk.CheckButton tts_engine_openai_radio {
