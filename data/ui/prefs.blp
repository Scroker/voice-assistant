using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog preferences_dialog {
  title: _("Preferences");
  content-width: 860;
  content-height: 600;
  search-enabled: true;

    // GENERAL PAGE
  Adw.PreferencesPage general_page {
    title: _("General");
    icon-name: "settings-symbolic";
    name: "general";

    Adw.PreferencesGroup {
      title: _("Voice Assistant");
      description: _("General configuration and assistant activation.");

      Adw.SwitchRow enable_switch_row {
        title: _("Enable Voice Assistant");
        subtitle: _("Enable or disable background listening");
      }
    }

    Adw.PreferencesGroup lang_group {
      title: _("Assistant Language");
      description: _("Language used for speech recognition and responses");

      Adw.ActionRow lang_selection_row {
        title: _("Language");
        subtitle: _("System Language");
        activatable: true;

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
          valign: center;
        }
      }
    }


    Adw.PreferencesGroup {
      title: _("Audio Input");
      description: _("Microphone processing applied before wake word detection and speech recognition.");

      Adw.ActionRow audio_subpage_row {
        title: _("Audio Filters");
        subtitle: _("Echo cancellation, high-pass, gain control and noise gate");
        activatable: true;

        [prefix]
        Gtk.Image {
          icon-name: "audio-input-microphone-symbolic";
          valign: center;
        }

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("System &amp; Maintenance");
      description: _("Manage downloaded models, disk storage, and diagnostics.");

      Adw.ActionRow models_subpage_row {
        title: _("Storage and Models");
        subtitle: _("Manage installed models and storage directory");
        activatable: true;

        [prefix]
        Gtk.Image {
          icon-name: "drive-harddisk-symbolic";
          valign: center;
        }

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
          valign: center;
        }
      }

      Adw.ActionRow bugreport_subpage_row {
        title: _("Bug Reporting");
        subtitle: _("Configure automatic crash reporting to Bugzilla");
        activatable: true;

        [prefix]
        Gtk.Image {
          icon-name: "dialog-warning-symbolic";
          valign: center;
        }

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
          valign: center;
        }
      }
    }
  }

  // WAKEWORD PAGE
  Adw.PreferencesPage wakeword_page {
    title: _("Wake Word");
    icon-name: "cafe-symbolic";
    name: "wakeword";

    Adw.PreferencesGroup wakeword_engine_group {
      title: _("Wakeword Engine");
      description: _("Vosk: any word — OpenWakeWord: fixed keywords — Sherpa-ONNX: custom ONNX keyword spotter");

      Adw.ActionRow ww_engine_vosk_row {
        title: _("Vosk (custom word)");
        activatable: true;
        activatable-widget: ww_engine_vosk_radio;

        [prefix]
        Gtk.CheckButton ww_engine_vosk_radio {
          valign: center;
          margin-end: 12;
        }
      }

      Adw.ActionRow ww_engine_oww_row {
        title: _("OpenWakeWord (fixed keywords)");
        activatable: true;
        activatable-widget: ww_engine_oww_radio;

        [prefix]
        Gtk.CheckButton ww_engine_oww_radio {
          group: ww_engine_vosk_radio;
          valign: center;
          margin-end: 12;
        }
      }

      Adw.ActionRow ww_engine_sherpa_row {
        title: _("Sherpa-ONNX (keyword spotting)");
        activatable: true;
        activatable-widget: ww_engine_sherpa_radio;

        [prefix]
        Gtk.CheckButton ww_engine_sherpa_radio {
          group: ww_engine_vosk_radio;
          valign: center;
          margin-end: 12;
        }
      }
    }

    Adw.PreferencesGroup wakeword_config_group {
      title: _("Configuration");

      Adw.ActionRow current_vosk_ww_model_row {
        title: _("Vosk Wake Word Model");
        subtitle: _("Loading information...");
        activatable: true;

        [prefix]
        Gtk.Image {
          icon-name: "audio-input-microphone-symbolic";
          margin-end: 12;
        }

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
          valign: center;
        }
      }

      Adw.ActionRow current_sherpa_model_row {
        title: _("Sherpa-ONNX Model");
        subtitle: _("Loading information...");
        activatable: true;
        visible: false;

        [prefix]
        Gtk.Image {
          icon-name: "audio-input-microphone-symbolic";
          margin-end: 12;
        }

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
          valign: center;
        }
      }

      Adw.EntryRow wakeword_row {
        title: _("Wakeword Keyword");
      }
    }

    Adw.PreferencesGroup oww_keyword_group {
      title: _("OpenWakeWord Keyword");
      description: _("Pre-trained keyword model to detect");
      visible: false;

      Adw.ActionRow oww_alexa_row {
        title: _("alexa");
        activatable: true;
        activatable-widget: oww_alexa_radio;

        [prefix]
        Gtk.CheckButton oww_alexa_radio {
          valign: center;
          margin-end: 12;
        }
      }

      Adw.ActionRow oww_hey_jarvis_row {
        title: _("hey_jarvis");
        activatable: true;
        activatable-widget: oww_hey_jarvis_radio;

        [prefix]
        Gtk.CheckButton oww_hey_jarvis_radio {
          group: oww_alexa_radio;
          valign: center;
          margin-end: 12;
        }
      }

      Adw.ActionRow oww_hey_mycroft_row {
        title: _("hey_mycroft");
        activatable: true;
        activatable-widget: oww_hey_mycroft_radio;

        [prefix]
        Gtk.CheckButton oww_hey_mycroft_radio {
          group: oww_alexa_radio;
          valign: center;
          margin-end: 12;
        }
      }

      Adw.ActionRow oww_hey_rhasspy_row {
        title: _("hey_rhasspy");
        activatable: true;
        activatable-widget: oww_hey_rhasspy_radio;

        [prefix]
        Gtk.CheckButton oww_hey_rhasspy_radio {
          group: oww_alexa_radio;
          valign: center;
          margin-end: 12;
        }
      }
    }
  }

  // STT PAGE
  Adw.PreferencesPage stt_page {
    title: _("Speech Engine (STT)");
    icon-name: "audio-input-microphone-symbolic";
    name: "stt";

    Adw.PreferencesGroup stt_mode_group {
      title: _("Speech Recognition Mode");
      description: _("Select whether to process voice locally on device or via a cloud API service.");

      Adw.ActionRow stt_mode_local_row {
        title: _("Local");
        subtitle: _("Offline speech recognition processed locally on device (Vosk / Whisper)");
        activatable: true;
        activatable-widget: stt_mode_local_radio;

        [prefix]
        Gtk.CheckButton stt_mode_local_radio {
          valign: center;
          margin-end: 12;
        }
      }

      Adw.ActionRow stt_mode_cloud_row {
        title: _("Cloud");
        subtitle: _("High-accuracy online speech recognition via API (OpenAI / Groq)");
        activatable: true;
        activatable-widget: stt_mode_cloud_radio;

        [prefix]
        Gtk.CheckButton stt_mode_cloud_radio {
          group: stt_mode_local_radio;
          valign: center;
          margin-end: 12;
        }
      }
    }

    Adw.PreferencesGroup stt_local_engine_group {
      title: _("Local Engine");
      description: _("Select local speech recognition engine.");

      Adw.ActionRow stt_engine_vosk_row {
        title: _("Vosk");
        subtitle: _("Fast streaming speech recognition (low CPU and RAM usage)");
        activatable: true;
        activatable-widget: stt_engine_vosk_radio;

        [prefix]
        Gtk.CheckButton stt_engine_vosk_radio {
          valign: center;
          margin-end: 12;
        }
      }

      Adw.ActionRow stt_engine_whisper_row {
        title: _("Whisper");
        subtitle: _("High accuracy neural transformer (supports GPU acceleration)");
        activatable: true;
        activatable-widget: stt_engine_whisper_radio;

        [prefix]
        Gtk.CheckButton stt_engine_whisper_radio {
          group: stt_engine_vosk_radio;
          valign: center;
          margin-end: 12;
        }
      }
    }

    Adw.PreferencesGroup stt_local_group {
      title: _("Local STT Model Configuration");
      description: _("Configure offline model execution.");

      Adw.ActionRow current_model_row {
        title: _("Active Local STT Model");
        subtitle: _("Loading information...");
        activatable: true;

        [prefix]
        Gtk.Image {
          icon-name: "audio-input-microphone-symbolic";
          margin-end: 12;
        }

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup whisper_hardware_group {
      title: _("Hardware Acceleration (Whisper)");
      description: _("Configure the compute device for Whisper execution.");

      Adw.ActionRow hw_cpu_row {
        title: _("CPU (Compatible with all systems)");
        subtitle: _("Standard execution via CPU");
        activatable: true;
        activatable-widget: hw_cpu_radio;

        [prefix]
        Gtk.CheckButton hw_cpu_radio {
          valign: center;
          margin-end: 12;
        }
      }

      Adw.ActionRow hw_cuda_row {
        title: _("CUDA (Nvidia GPU)");
        subtitle: _("Hardware acceleration via Nvidia graphics card");
        activatable: true;
        activatable-widget: hw_cuda_radio;

        [prefix]
        Gtk.CheckButton hw_cuda_radio {
          group: hw_cpu_radio;
          valign: center;
          margin-end: 12;
        }
      }
    }

    Adw.PreferencesGroup stt_cloud_group {
      title: _("Cloud STT Provider");
      description: _("Choose provider for Cloud STT.");
      visible: false;

      Adw.ActionRow stt_cloud_openai_row {
        title: _("OpenAI Whisper Cloud");
        subtitle: _("api.openai.com");
        activatable: true;
        activatable-widget: stt_cloud_openai_radio;

        [prefix]
        Gtk.CheckButton stt_cloud_openai_radio {
          valign: center;
          margin-end: 12;
        }
      }

      Adw.ActionRow stt_cloud_groq_row {
        title: _("Groq Whisper Cloud");
        subtitle: _("api.groq.com");
        activatable: true;
        activatable-widget: stt_cloud_groq_radio;

        [prefix]
        Gtk.CheckButton stt_cloud_groq_radio {
          group: stt_cloud_openai_radio;
          valign: center;
          margin-end: 12;
        }
      }
    }

    Adw.PreferencesGroup stt_cloud_config_group {
      title: _("Cloud Configuration");
      visible: false;

      Adw.EntryRow stt_cloud_api_key_row {
        title: _("API Key");
      }

      Adw.EntryRow stt_cloud_model_row {
        title: _("Cloud Model Name");
      }
    }
  }

  // LLM PAGE
  Adw.PreferencesPage llm_page {
    title: _("Artificial Intelligence (LLM)");
    icon-name: "brain-augmented-symbolic";
    name: "llm";

    Adw.PreferencesGroup {
      title: _("Large Language Model (LLM)");
      description: _("Enable and configure text generation capabilities.");

      Adw.SwitchRow llm_enable_row {
        title: _("Enable LLM Responses");
        subtitle: _("Send voice transcriptions to the LLM to generate intelligent responses");
      }
    }

    Adw.PreferencesGroup llm_mode_group {
      title: _("Execution Mode");
      description: _("Select whether to run the language model locally on device or via a cloud API service.");

      Adw.ActionRow llm_mode_local_row {
        title: _("Local");
        subtitle: _("Offline language model executed locally on device (GGUF / Ollama)");
        activatable: true;
        activatable-widget: llm_mode_local_radio;

        [prefix]
        Gtk.CheckButton llm_mode_local_radio {
          valign: center;
          margin-end: 12;
        }
      }

      Adw.ActionRow llm_mode_cloud_row {
        title: _("Cloud");
        subtitle: _("High-capability online language model via cloud API (OpenAI / Anthropic / Custom)");
        activatable: true;
        activatable-widget: llm_mode_cloud_radio;

        [prefix]
        Gtk.CheckButton llm_mode_cloud_radio {
          group: llm_mode_local_radio;
          valign: center;
          margin-end: 12;
        }
      }
    }

    Adw.PreferencesGroup llm_local_engine_group {
      title: _("Local Engine");
      description: _("Select local runtime provider.");

      Adw.ActionRow llm_local_gguf_row {
        title: _("Local GGUF (In-Daemon Llama 3.2)");
        subtitle: _("Runs locally within Python daemon");
        activatable: true;
        activatable-widget: llm_local_gguf_radio;

        [prefix]
        Gtk.CheckButton llm_local_gguf_radio {
          valign: center;
          margin-end: 12;
        }
      }

      Adw.ActionRow llm_local_ollama_row {
        title: _("Ollama (Local HTTP)");
        subtitle: _("Connect to local Ollama instance (localhost:11434)");
        activatable: true;
        activatable-widget: llm_local_ollama_radio;

        [prefix]
        Gtk.CheckButton llm_local_ollama_radio {
          group: llm_local_gguf_radio;
          valign: center;
          margin-end: 12;
        }
      }
    }

    Adw.PreferencesGroup llm_local_group {
      title: _("Local LLM Model Configuration");
      description: _("Configure offline GGUF model execution.");

      Adw.ActionRow current_llm_model_row {
        title: _("Active Local LLM Model");
        subtitle: _("Loading information...");
        activatable: true;

        [prefix]
        Gtk.Image {
          icon-name: "brain-augmented-symbolic";
          margin-end: 12;
        }

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup llm_cloud_engine_group {
      title: _("Cloud LLM Provider");
      description: _("Select cloud API provider for language modeling.");
      visible: false;

      Adw.ActionRow llm_cloud_openai_row {
        title: _("OpenAI Cloud API");
        subtitle: _("ChatGPT models via api.openai.com");
        activatable: true;
        activatable-widget: llm_cloud_openai_radio;

        [prefix]
        Gtk.CheckButton llm_cloud_openai_radio {
          valign: center;
          margin-end: 12;
        }
      }

      Adw.ActionRow llm_cloud_anthropic_row {
        title: _("Anthropic Claude API");
        subtitle: _("Claude 3.5 models via api.anthropic.com");
        activatable: true;
        activatable-widget: llm_cloud_anthropic_radio;

        [prefix]
        Gtk.CheckButton llm_cloud_anthropic_radio {
          group: llm_cloud_openai_radio;
          valign: center;
          margin-end: 12;
        }
      }

      Adw.ActionRow llm_cloud_deepseek_row {
        title: _("DeepSeek API");
        subtitle: _("DeepSeek-V3 &amp; R1 models via api.deepseek.com");
        activatable: true;
        activatable-widget: llm_cloud_deepseek_radio;

        [prefix]
        Gtk.CheckButton llm_cloud_deepseek_radio {
          group: llm_cloud_openai_radio;
          valign: center;
          margin-end: 12;
        }
      }

      Adw.ActionRow llm_cloud_ollama_row {
        title: _("Ollama Cloud");
        subtitle: _("Ollama Cloud models via ollama.com");
        activatable: true;
        activatable-widget: llm_cloud_ollama_radio;

        [prefix]
        Gtk.CheckButton llm_cloud_ollama_radio {
          group: llm_cloud_openai_radio;
          valign: center;
          margin-end: 12;
        }
      }

      Adw.ActionRow llm_cloud_custom_row {
        title: _("Custom HTTP Endpoint");
        subtitle: _("Custom OpenAI-compatible API server");
        activatable: true;
        activatable-widget: llm_cloud_custom_radio;

        [prefix]
        Gtk.CheckButton llm_cloud_custom_radio {
          group: llm_cloud_openai_radio;
          valign: center;
          margin-end: 12;
        }
      }
    }

    Adw.PreferencesGroup llm_cloud_config_group {
      title: _("Cloud Configuration");
      visible: false;

      Adw.EntryRow llm_api_key_row {
        title: _("API Key");
      }

      Adw.EntryRow llm_url_row {
        title: _("Server Endpoint URL");
      }

      Adw.ActionRow llm_cloud_model_row {
        title: _("Active Cloud Model");
        subtitle: _("Select model…");
        activatable: true;

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup llm_system_prompt_group {
      title: _("System Instructions");

      Adw.EntryRow llm_system_prompt_row {
        title: _("System Prompt (Instructions)");
      }
    }

    Adw.PreferencesGroup {
      title: _("Tools &amp; Extensions");
      description: _("Model Context Protocol (MCP) integrations and capabilities.");

      Adw.ActionRow mcp_subpage_row {
        title: _("Tools (MCP)");
        subtitle: _("Configure Model Context Protocol tools and servers");
        activatable: true;

        [prefix]
        Gtk.Image {
          icon-name: "system-run-symbolic";
          valign: center;
        }

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Command Processing");
      description: _("How a recognized command is dispatched before reaching the full assistant.");

      Adw.ActionRow dispatch_subpage_row {
        title: _("Command Dispatch");
        subtitle: _("Enable or disable the Fast-Path and Medium-Path stages");
        activatable: true;

        [prefix]
        Gtk.Image {
          icon-name: "media-playlist-consecutive-symbolic";
          valign: center;
        }

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
          valign: center;
        }
      }

      Adw.ActionRow skills_subpage_row {
        title: _("Skills");
        subtitle: _("View built-in skills and add your own trigger phrases");
        activatable: true;

        [prefix]
        Gtk.Image {
          icon-name: "applications-utilities-symbolic";
          valign: center;
        }

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
          valign: center;
        }
      }
    }
  }

  // TTS PAGE
  Adw.PreferencesPage tts_page {
    title: _("Text-to-Speech (TTS)");
    icon-name: "audio-volume-high-symbolic";
    name: "tts";

    Adw.PreferencesGroup {
      title: _("Speech Synthesis (Text-To-Speech)");
      description: _("Configure the voice engine for audio playback of assistant responses.");

      Adw.SwitchRow tts_enable_row {
